{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "vis-questoes",
      "runtimeExecutable": "pipeline/.venv/Scripts/python",
      "runtimeArgs": [
        "-I",
