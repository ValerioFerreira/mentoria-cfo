// Schema do MentorIA — Missão Oficial CBMPE.
// Duas partes: (1) CONTEÚDO — semeado a partir de /content, somente leitura em runtime;
// (2) USUÁRIO — plano, atividades, tempo, cadernos e métricas.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  USER
  ADMIN
}

enum ExamBlock {
  I
  II
  III
}

enum HoursBand {
  LEVE // 14–21 h/sem
  MODERADO // 22–28 h/sem
  AVANCADO // > 28 h/sem
}

enum ForeignLanguage {
  EN
  ES
}

enum ContentSource {
  BASE // material-base da disciplina (a diretriz aponta as páginas)
  LEGAL_PUBLICO // texto legal público (diretriz aponta dispositivo/artigos)
  AUTHORED // material complementar autoral do MentorIA (PDF próprio) que preenche lacunas do edital
}

enum AulaKind {
  THEORY
  PRACTICE // somente questões (ex.: Português Aula 14, provas comentadas)
}

enum EditalFit {
  YES
  PARTIAL
  NO
}

enum GapSeverity {
  HIGH
  MEDIUM
  LOW
}

enum ActivityScope {
  AULA
  FINAL // revisão geral / caderno misto das semanas finais
}

enum ActivityType {
  TEORIA
  REVISAO
  FIXACAO
  QUESTOES
}

enum ActivityStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum WeekKind {
  CONTENT
  FINAL_REVIEW
}

enum PlanStatus {
  PENDING_ANALYSIS
  ACTIVE
  ARCHIVED
}

enum BizuSet {
  TEORIA
  REVISAO
}

enum QuestionStatus {
  DRAFT
  APPROVED
  FLAGGED
  RETIRED
}

// Formato da questão objetiva (cadernos do TecConcursos trazem os dois)
enum QuestionKind {
  MULTIPLA_ESCOLHA // 4 ou 5 alternativas (A–E)
  CERTO_ERRADO // item para julgar: opções "C" (Certo) e "E" (Errado)
}

// Quem decidiu o trecho/assunto da questão: o importador ou uma pessoa em /admin/revisao
enum ClassifiedBy {
  AUTO
  MANUAL
}

enum TimeSource {
  TIMER
  MANUAL
}

enum QuizKind {
  CADERNO // 25 questões / 60 min, atrelado a atividade Questões
  SIMULADO_BLOCO // revisão final: bloco inteiro
  SIMULADO // Simulado completo de prova oficial do edital
  CADERNO_PERSONALIZADO // Caderno montado pelo aluno na página de questões
}

enum SummaryStatus {
  DRAFT
  APPROVED
}

enum Contest {
  CBMPE_SOLDADO // CBMPE · Soldado (Praça)
  CBMPE_OFICIAL // CBMPE · 2º Tenente (Oficial)
  CBMPE_CFOA // CBMPE · 2º Tenente CFOA (Oficiais da Administração)
  PCPE_AGENTE // PCPE · Agente de Polícia
  PMPE_SOLDADO // PMPE · Soldado (Praça)
  PMPE_OFICIAL // PMPE · 2º Tenente (Oficial)
  CBMPE_COMBO // Pacote: CBMPE 2º Tenente + Soldado
  PMPE_COMBO // Pacote: PMPE 2º Tenente + Soldado
}

enum WaitlistPlan {
  MONTHLY // mensalidade
  UNTIL_EXAM // chave histórica; novas ofertas deste preço são acesso permanente
}

enum BillingProduct {
  MONTHLY
  PERMANENT
}

enum BillingStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  REFUNDED
  CHARGEBACK
}

enum BillingPaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CHARGEBACK // Legacy value; migrated payment rows are normalized by the access-policy migration.
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CHARGEBACK_LOST
  CHARGEBACK_WON
}

enum BillingDisputeStatus {
  IN_PROGRESS
  LOST
  WON
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ───────── Modelo comercial: acesso até a prova, controle financeiro manual e parceiros ─────────

// Categoria de preço do concurso (persistida em ContestSetting; nunca deduzida do nome)
enum ContestCategory {
  OFICIAL
  PCPE
  PRACA
  COMBO
}

// Situação FINANCEIRA da contratação (o acesso acadêmico é controlado à parte)
enum ContractStatus {
  OPEN // nada recebido
  PARTIAL // recebido < devido
  PAID // recebido = devido
  OVERPAID // recebido > devido: excedente para tratamento administrativo
  CANCELLED // cancelada sem valores recebidos (histórico preservado)
}

enum PaymentMethod {
  PIX
  TRANSFERENCIA
  DINHEIRO
  OUTRO
  CARTAO // pagamentos online pelo Checkout Pro do Mercado Pago (cartão e demais meios)
}

// Quem lançou o recebimento: o administrador (manual) ou a conciliação automática do Mercado Pago.
enum PaymentSource {
  MANUAL
  MERCADO_PAGO
}

enum OnlineChargeKind {
  PIX // pagamento Pix dinâmico (QR Code e copia e cola)
  CHECKOUT // Checkout Pro: página do Mercado Pago (cartão e outros meios)
}

enum OnlineChargeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
  CHARGED_BACK
}

enum ReversalKind {
  ESTORNO // devolução ao cliente
  CORRECAO // lançamento corrigido (valor ou registro indevido)
}

enum CommissionKind {
  ACCRUAL // comissão gerada por valor recebido
  REVERSAL // comissão revertida por estorno/correção
}

// ───────────────────── CONTEÚDO (semeado) ─────────────────────

model Subject {
  id                   String           @id // slug: "dir-administrativo"
  name                 String
  block                ExamBlock
  examQuestions        Int // nº de questões na prova (peso)
  languageGroup        String? // "lingua-estrangeira" p/ Inglês/Espanhol (mutuamente exclusivos)
  foreignLanguage      ForeignLanguage?
  sortOrder            Int
  materialCompleteness Float            @default(1) // fatia do edital que o material cobre (estimativa)

  aulas       Aula[]
  editalItems EditalItem[]
  gaps        Gap[]
  planLinks   PlanSubject[]
  activities  Activity[]
  questions   Question[]
}

model Aula {
  id             String        @id // "dir-administrativo/a00"
  subjectId      String
  number         Int
  title          String
  shortTitle     String
  kind           AulaKind      @default(THEORY)
  source         ContentSource @default(BASE)
  edital         EditalFit     @default(YES)
  selectable     Boolean       @default(true) // false: fora do edital ou aula de prática já vinculada a outras
  totalPages     Int
  theoryPages    Int
  segmentCount   Int
  commentedPages Int           @default(0)
  listPages      Int           @default(0)
  commentedRuns  Json // [[ini, fim], ...] páginas da seção de questões comentadas
  practiceLinks  Json // [{theme, startPage, endPage, sourceAula}] vindos de aulas de prática
  printedOffset  Int           @default(0) // página impressa = página PDF + offset
  incidence      Float         @default(0) // proxy de incidência em prova (normalizada na disciplina)
  note           String?
  // material autoral (source = AUTHORED): caminho do PDF servido pelo app, ex.: "complementos/leg-pe-decreto-50014.pdf"
  materialPath   String?
  onlyContests   String[]      @default([])
  excludeContests String[]     @default([])

  subject    Subject    @relation(fields: [subjectId], references: [id])
  topics     Topic[]
  segments   Segment[]
  questions  Question[]
  activities Activity[]

  @@unique([subjectId, number])
  @@index([subjectId])
}

// Assuntos do edital de cada disciplina (content/edital/<disciplina>.json). A anamnese pergunta o que o aluno já estudou
// por assunto; o planejador traduz as respostas para as aulas que cobrem cada assunto.
model EditalItem {
  id        String @id // "lingua-portuguesa/e1", "direito-constitucional/e3.1"
  subjectId String
  code      String // numeração no edital: "1", "3.5"
  title     String
  aulaIds   Json // aulas da própria disciplina (planejáveis) que tratam do assunto
  sortOrder Int
  // Concursos a que o assunto se aplica. Vazio em `onlyContests` = todos; `excludeContests` tira concursos que têm o
  // próprio edital da disciplina (ex.: PCPE_AGENTE usa `<disciplina>/p<código>` no lugar dos assuntos padrão).
  onlyContests    String[] @default([])
  excludeContests String[] @default([])

  subject    Subject    @relation(fields: [subjectId], references: [id])
  activities Activity[]
  questions  Question[]

  @@index([subjectId, sortOrder])
}

model Gap {
  id         String      @id
  subjectId  String
  item       String
  evidence   String
  severity   GapSeverity
  remedy     String
  // true quando um material complementar do MentorIA já preenche a lacuna (resolution explica qual)
  resolved   Boolean     @default(false)
  resolution String?

  subject Subject @relation(fields: [subjectId], references: [id])
}

model Topic {
  id          String  @id // "dir-administrativo/a00/t012"
  aulaId      String
  parentId    String?
  level       Int
  title       String
  pdfPage     Int
  printedPage Int?
  sortOrder   Int
  verified    Boolean @default(false) // título confirmado por busca textual no PDF
  auto        Boolean @default(false) // subtítulo detectado por fonte (não veio do índice .xlsx)

  aula      Aula       @relation(fields: [aulaId], references: [id])
  parent    Topic?     @relation("TopicTree", fields: [parentId], references: [id])
  children  Topic[]    @relation("TopicTree")
  questions Question[]

  @@index([aulaId, sortOrder])
}

// Trecho de teoria de ~1 h (10–17 págs.), unidade das atividades Teoria/Revisão/Questões.
model Segment {
  id              String  @id // "dir-administrativo/a00/s01"
  aulaId          String
  sortOrder       Int
  startPage       Int
  endPage         Int
  startPrinted    Int?
  endPrinted      Int?
  pages           Int
  load            Float // soma ponderada de densidade (alvo ≈ 12)
  startTopic      String?
  startsMidTopic  Boolean @default(false)
  stopBeforeTopic String? // null = último trecho da teoria (ou corte no meio de tópico)
  endsMidTopic    Boolean @default(false)
  endTopic        String?
  endsTheory      Boolean @default(false)
  topicsCovered   Json // títulos de tópicos que começam no trecho
  estMinutes      Int     @default(60)

  aula       Aula                @relation(fields: [aulaId], references: [id])
  bizu       Bizu?
  analytic   AnalyticSummary?
  importance SegmentImportance[]
  questions  Question[]
  activities ActivitySegment[]
  notes      Note[]

  @@unique([aulaId, sortOrder])
}

// Resumo analítico do trecho (≤ 20 min de leitura): substitui a leitura do material no Modo Turbo ou a pedido do aluno,
// e é uma das opções de leitura na Revisão. Texto próprio do sistema (nunca verbatim do material-base).
model AnalyticSummary {
  id          String        @id @default(cuid())
  segmentId   String        @unique
  markdown    String
  words       Int
  readMinutes Int
  status      SummaryStatus @default(DRAFT)
  // impressão digital do trecho quando o resumo foi escrito (id é posicional: se o trecho mudar, o resumo fica órfão)
  fingerprint Json
  version     Int           @default(1)
  updatedAt   DateTime      @updatedAt

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
}

// Importância do trecho em cada concurso: `appears` = o assunto consta no edital do concurso; `score` 1–100 (percentil das
// questões esperadas no concurso). Fonte: content/importance/segments.json (pipeline/importance.py).
model SegmentImportance {
  segmentId String
  contest   Contest
  appears   Boolean
  expected  Float // questões esperadas na prova do concurso
  score     Int? // null quando o assunto não aparece no concurso

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([segmentId, contest])
  @@index([contest, score])
}

model Bizu {
  id        String @id @default(cuid())
  segmentId String @unique
  summary   String // markdown em palavras próprias (nunca verbatim do material-base)
  version   Int    @default(1)

  segment Segment    @relation(fields: [segmentId], references: [id])
  items   BizuItem[]
}

// Itens Certo/Errado de fixação rápida.
model BizuItem {
  id          String  @id @default(cuid())
  bizuId      String
  set         BizuSet // TEORIA ou REVISAO (conjuntos diferentes)
  statement   String
  isTrue      Boolean
  explanation String
  sortOrder   Int

  bizu    Bizu         @relation(fields: [bizuId], references: [id])
  answers BizuAnswer[]

  @@index([bizuId, set])
}

model Question {
  id          String         @id // "dir-administrativo/a00/s01/q007"
  subjectId   String
  aulaId      String
  segmentId   String
  topicId     String?
  topic       String? // assunto da questão (texto livre; usado nos "pontos de atenção")
  support     String? // texto-base (interpretação, charge, código etc.)
  statement   String
  explanation String // comentário/justificativa
  difficulty  Int            @default(2) // 1 fácil · 2 média · 3 difícil
  pattern     String // padrão AOCP usado (assertivas, lei-seca, calculo, interpretacao…)
  pageRef     Int? // página PDF de referência (para revisão)
  status      QuestionStatus @default(DRAFT)
  batch       String? // lote de geração (rastreabilidade)
  banca       String         @default("AOCP")
  kind        QuestionKind   @default(MULTIPLA_ESCOLHA)

  // Importação dos cadernos (pipeline/questoes; ver EXTRACAO.md)
  externalId    String?      @unique // id da questão na origem (número do TecConcursos)
  editalItemId  String? // assunto do edital ("informatica/e1.2"), derivado do trecho
  tecMateria    String? // "Informática"
  tecAssunto    String? // "Windows 10"
  orgao         String?
  cargo         String?
  ano           Int?
  sourceFile    String? // caderno de onde veio a versão atual
  contentHash   String? // sha256 do texto + gabarito (detecta mudança ao reimportar)
  classifyScore Float? // similaridade do trecho escolhido
  classifyNote  String? // motivo/sugestão da classificação (mostrado na revisão)
  classifiedBy  ClassifiedBy @default(AUTO)
  importedAt    DateTime?

  subject    Subject          @relation(fields: [subjectId], references: [id])
  aula       Aula             @relation(fields: [aulaId], references: [id])
  segment    Segment          @relation(fields: [segmentId], references: [id])
  topicRef   Topic?           @relation(fields: [topicId], references: [id])
  editalItem EditalItem?      @relation(fields: [editalItemId], references: [id])
  options    QuestionOption[]
  answers    QuizAnswer[]
  reports    QuestionReport[]

  @@index([segmentId, status])
  @@index([subjectId, status])
  @@index([editalItemId, status])
  @@index([banca])
}

// Figuras e recortes (fórmulas, tabelas) das questões, servidos por /q-img/<id>. id = sha256 do PNG.
model QuestionImage {
  id        String   @id
  mime      String   @default("image/png")
  data      Bytes
  width     Int
  height    Int
  createdAt DateTime @default(now())
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String // "A".."E"
  text       String
  isCorrect  Boolean

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
}

// ───────────────────── USUÁRIO ─────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  username           String?   @unique // minúsculas; vem da lista de espera (contas antigas não têm)
  passwordHash       String
  role               Role      @default(USER)
  mustChangePassword Boolean   @default(false)
  accessExpiresAt    DateTime?
  createdAt          DateTime  @default(now())

  sessions         Session[]
  profile          Profile?
  plans            Plan[]
  timeLogs         TimeLog[]
  notes            Note[]
  quizSessions     QuizSession[]
  bizuAnswers      BizuAnswer[]
  reports          QuestionReport[]
  invite           Invite?
  billingPurchases BillingPurchase[]

  partner           Partner?          @relation("PartnerUser")
  contracts         Contract[]        @relation("ContractUser")
  referralsReceived PartnerReferral[] @relation("ReferralUser")
  paymentsLogged    ManualPayment[]   @relation("PaymentCreatedBy")
  reversalsLogged   PaymentReversal[] @relation("ReversalCreatedBy")
  payoutsLogged     PartnerPayout[]   @relation("PayoutCreatedBy")
}

// Categoria e data oficial da prova de cada concurso. Sem categoria: sem preço (revisão administrativa).
// Sem data: a contratação é registrada, mas o acesso "até a prova" fica pendente.
model ContestSetting {
  contest     Contest          @id
  category    ContestCategory?
  examDate    DateTime?        @db.Date
  /// Preço original definido para este concurso (centavos); nulo = preço padrão da categoria
  priceCents         Int?
  /// Desconto do site em pontos percentuais (0–100); nulo = desconto padrão de lançamento
  siteDiscountPoints Int?
  updatedById String?
  updatedAt   DateTime         @updatedAt
}

// Contratação de acesso ilimitado até a prova = obrigação financeira. Preço, descontos e regra ficam congelados:
// mudanças futuras de preço não alteram contratações já registradas. `paidAmount` e `status` são materializados
// e sempre recalculados a partir de ManualPayment − PaymentReversal (reconciliáveis com o histórico).
model Contract {
  id                    String          @id @default(cuid())
  userId                String? // nulo enquanto a inscrição da lista de espera não vira conta
  customerEmail         String // minúsculas
  customerName          String?
  waitlistEntryId       String?
  contest               Contest
  category              ContestCategory
  examDateAtContract    DateTime?       @db.Date // data oficial conhecida no momento da contratação
  pricingRule           String // identificador da regra comercial aplicada
  originalAmount        Decimal         @db.Decimal(10, 2)
  launchDiscountPoints  Int
  partnerDiscountPoints Int             @default(0)
  /// soma dos pontos dos cupons do site aplicados (aditivos sobre o preço original; detalhe em ContractCoupon)
  couponDiscountPoints  Int             @default(0)
  discountAmount        Decimal         @db.Decimal(10, 2)
  finalAmount           Decimal         @db.Decimal(10, 2)
  couponId              String?
  couponCode            String? // código usado (cópia: trocar o cupom não altera o histórico)
  partnerId             String?
  status                ContractStatus  @default(OPEN)
  paidAmount            Decimal         @default(0) @db.Decimal(10, 2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  cancelledAt           DateTime?
  cancelReason          String?
  cancelledById         String?
  accessGrantedAt       DateTime?
  accessUntil           DateTime?
  accessGrantedById     String?

  user          User?             @relation("ContractUser", fields: [userId], references: [id], onDelete: SetNull)
  waitlistEntry WaitlistEntry?    @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  coupon        PartnerCoupon?    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  partner       Partner?          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  payments      ManualPayment[]
  reversals     PaymentReversal[]
  commissions   CommissionEntry[]
  referral      PartnerReferral?
  charges       OnlineCharge[]
  siteCoupons   ContractCoupon[]

  @@index([userId])
  @@index([waitlistEntryId])
  @@index([customerEmail, contest])
  @@index([partnerId, createdAt])
  @@index([status, createdAt])
  @@index([contest, createdAt])
}

// Pagamento recebido, lançado manualmente pelo administrador. Imutável: correções só por PaymentReversal.
model ManualPayment {
  id                String        @id @default(cuid())
  contractId        String
  amount            Decimal       @db.Decimal(10, 2)
  paidAt            DateTime // data efetiva do pagamento
  method            PaymentMethod
  receiptRef        String? // identificador do comprovante (ex.: id da transação Pix)
  note              String?
  createdById       String? // nulo nos recebimentos conciliados automaticamente (source MERCADO_PAGO)
  source            PaymentSource @default(MANUAL)
  providerPaymentId String?       @unique // id do pagamento no Mercado Pago (um recebimento por pagamento aprovado)
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())

  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  reversals   PaymentReversal[]
  commissions CommissionEntry[]

  @@index([contractId, paidAt])
  @@index([paidAt])
  @@index([method, paidAt])
  @@index([receiptRef])
}

// Tentativa de cobrança online de uma contratação pelo Mercado Pago (conta da empresa). Não é dinheiro recebido:
// o recebimento só existe como ManualPayment (source MERCADO_PAGO) depois que a consulta autenticada à API do
// Mercado Pago confirma a aprovação. O valor sai sempre do saldo da contratação, calculado no servidor.
model OnlineCharge {
  id                String             @id @default(cuid())
  contractId        String
  kind              OnlineChargeKind
  amount            Decimal            @db.Decimal(10, 2)
  status            OnlineChargeStatus @default(PENDING)
  providerPaymentId String?            @unique // Pix: id do pagamento
  preferenceId      String?            @unique // Checkout Pro: id da preferência
  checkoutUrl       String?
  qrCode            String?            @db.Text
  qrCodeBase64      String?            @db.Text
  ticketUrl         String?
  expiresAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([contractId, status])
  @@index([status, expiresAt])
}

// Estorno ou correção auditável de um pagamento (parcial ou total), com justificativa.
model PaymentReversal {
  id             String        @id @default(cuid())
  paymentId      String
  contractId     String
  amount         Decimal       @db.Decimal(10, 2)
  kind           ReversalKind
  reason         String
  effectiveAt    DateTime
  createdById    String? // nulo nos estornos vindos do Mercado Pago (source MERCADO_PAGO)
  source         PaymentSource @default(MANUAL)
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  payment     ManualPayment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  contract    Contract          @relation(fields: [contractId], references: [id], onDelete: Restrict)
  createdBy   User?             @relation("ReversalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  commissions CommissionEntry[]

  @@index([paymentId])
  @@index([contractId])
}

// Parceiro divulgador: um usuário comum (role USER) com permissões de parceiro enquanto `active`.
model Partner {
  id            String    @id @default(cuid())
  userId        String    @unique
  active        Boolean   @default(true)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deactivatedAt DateTime?

  user        User              @relation("PartnerUser", fields: [userId], references: [id], onDelete: Restrict)
  coupons     PartnerCoupon[]
  referrals   PartnerReferral[]
  contracts   Contract[]
  commissions CommissionEntry[]
  payouts     PartnerPayout[]

  @@index([active])
}

// Cupom exclusivo do parceiro. Códigos nunca são reaproveitados (únicos mesmo depois de desativados).
model PartnerCoupon {
  id             String    @id @default(cuid())
  partnerId      String
  code           String    @unique // maiúsculas
  discountPoints Int // pontos percentuais adicionais sobre o preço original
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  deactivatedAt  DateTime?
  replacedAt     DateTime?

  partner   Partner           @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  contracts Contract[]
  referrals PartnerReferral[]

  @@index([partnerId, active])
}

// Cupom do site (gerido em /admin/cupons). Desconto em pontos percentuais SOMADOS sobre o preço original, junto com o
// desconto de lançamento e o cupom de parceiro (nunca em cascata). Códigos únicos também em relação a PartnerCoupon.
// Cupom já usado numa contratação não é excluído (só inativado): o histórico fica congelado em ContractCoupon.
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // maiúsculas
  discountPoints Int // 1 a 100
  active         Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deactivatedAt  DateTime?

  contracts ContractCoupon[]
}

// Cupom do site usado numa contratação, com código e percentual congelados no momento do cadastro.
model ContractCoupon {
  id             String   @id @default(cuid())
  contractId     String
  couponId       String
  code           String
  discountPoints Int // pontos pedidos pelo cupom
  appliedPoints  Int // pontos efetivamente aplicados (após o teto de 100% do total)
  createdAt      DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@unique([contractId, couponId])
  @@index([couponId])
}

// Indicação: primeiro vínculo válido de um cliente (por e-mail) com um parceiro, criado pela 1ª contratação com cupom.
// Nunca é transferido: contratações posteriores com outro cupom geram comissão ao parceiro do cupom usado nelas.
model PartnerReferral {
  id              String   @id @default(cuid())
  partnerId       String
  customerEmail   String   @unique
  userId          String?
  couponId        String
  couponCode      String
  firstContractId String   @unique
  createdAt       DateTime @default(now())

  partner       Partner       @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  user          User?         @relation("ReferralUser", fields: [userId], references: [id], onDelete: SetNull)
  coupon        PartnerCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  firstContract Contract      @relation(fields: [firstContractId], references: [id], onDelete: Restrict)

  @@index([partnerId, createdAt])
}

// Razão de comissões: cada lançamento nasce de um pagamento (ACCRUAL) ou de um estorno (REVERSAL) e guarda a origem.
// A soma por contratação é sempre round(30% × min(recebido válido, devido)). `sourceKey` impede lançamento repetido.
model CommissionEntry {
  id          String         @id @default(cuid())
  partnerId   String
  contractId  String
  paymentId   String // pagamento que originou (ou que foi estornado)
  reversalId  String?
  kind        CommissionKind
  amount      Decimal        @db.Decimal(10, 2) // positivo (ACCRUAL) ou negativo (REVERSAL)
  basisAmount Decimal        @db.Decimal(10, 2) // valor do pagamento/estorno que disparou o lançamento
  rateBp      Int // taxa em pontos-base (3000 = 30%)
  availableAt DateTime // a partir de quando conta no saldo disponível
  sourceKey   String         @unique
  createdAt   DateTime       @default(now())

  partner  Partner          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  contract Contract         @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payment  ManualPayment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  reversal PaymentReversal? @relation(fields: [reversalId], references: [id], onDelete: Restrict)

  @@index([partnerId, createdAt])
  @@index([contractId])
}

// Repasse de comissão já pago ao parceiro (informado manualmente pelo administrador).
model PartnerPayout {
  id             String   @id @default(cuid())
  partnerId      String
  amount         Decimal  @db.Decimal(10, 2)
  paidAt         DateTime
  method         String // forma de pagamento ou referência
  receiptRef     String?
  note           String?
  createdById    String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  createdBy User    @relation("PayoutCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([partnerId, paidAt])
}

// Histórico de alterações administrativas e financeiras (sem senhas, tokens ou dados sensíveis desnecessários).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

// Contratos criados pelo checkout. Cada compra permanece independente para que
// o cancelamento da recorrência não remova um acesso permanente já adquirido.
model BillingPurchase {
  id                String         @id @default(cuid())
  userId            String
  product           BillingProduct
  status            BillingStatus  @default(PENDING)
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("BRL")
  externalReference String         @unique @default(cuid())
  mpPreferenceId    String?        @unique
  mpPreapprovalId   String?        @unique
  mpPixPaymentId    String?        @unique
  checkoutUrl       String?
  pixQrCode         String?        @db.Text
  pixQrCodeBase64   String?        @db.Text
  pixTicketUrl      String?
  pixExpiresAt      DateTime?
  currentPeriodEnd  DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments BillingPayment[]

  @@index([userId, product, status])
  @@index([status, currentPeriodEnd])
}

// Um registro por pagamento consultado diretamente na API do Mercado Pago.
model BillingPayment {
  id                String               @id @default(cuid())
  purchaseId        String
  providerPaymentId String               @unique
  status            BillingPaymentStatus
  amount            Decimal              @db.Decimal(10, 2)
  currency          String               @default("BRL")
  statusDetail      String?
  paidAt            DateTime?
  accessUntil       DateTime?
  updatedAt         DateTime             @updatedAt
  createdAt         DateTime             @default(now())

  purchase BillingPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  disputes BillingDispute[]

  @@index([purchaseId, status])
  @@index([status, accessUntil])
}

// Um registro por caso de contestação; os webhooks repetidos atualizam o mesmo caso.
model BillingDispute {
  id                   String               @id @default(cuid())
  billingPaymentId     String
  providerChargebackId String               @unique
  status               BillingDisputeStatus
  statusDetail         String?
  amount               Decimal              @db.Decimal(10, 2)
  currency             String               @default("BRL")
  lastEventAt          DateTime             @default(now())
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  payment BillingPayment @relation(fields: [billingPaymentId], references: [id], onDelete: Cascade)

  @@index([billingPaymentId, status])
}

// Idempotência dos webhooks; não armazenamos corpo bruto nem dados de cartão.
model BillingWebhookEvent {
  id           String    @id @default(cuid())
  eventKey     String    @unique
  resourceId   String
  topic        String
  action       String?
  resultStatus String?
  resultDetail String?
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([resourceId, topic])
}

// Sessão opaca: o cookie guarda um token aleatório; aqui fica apenas o hash SHA-256 dele.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invite {
  id           String    @id @default(cuid())
  code         String    @unique
  email        String? // opcional: restringe a um e-mail
  makeAdmin    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  usedAt       DateTime?
  usedByUserId String?   @unique

  usedBy User? @relation(fields: [usedByUserId], references: [id])
}

model Profile {
  userId          String           @id
  examDate        DateTime         @db.Date
  hoursBand       HoursBand?
  hoursPerWeek    Int? // valor efetivo escolhido (14–50)
  foreignLanguage ForeignLanguage?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Plan {
  id        String     @id @default(cuid())
  userId    String
  version   Int        @default(1)
  status    PlanStatus @default(ACTIVE)
  startDate DateTime   @db.Date
  examDate  DateTime   @db.Date
  contest   Contest? // concurso para o qual o plano foi montado (planos antigos: null = CBMPE_OFICIAL)
  params    Json // H, banda, semanas, capacidade, seed do sorteio
  coverage  Json // cobertura por disciplina + lista "ficou de fora"
  warnings  Json // avisos do planejador (lacunas do material, tempo curto…)
  createdAt DateTime   @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects PlanSubject[]
  weeks    Week[]

  @@index([userId, status])
}

model PlanSubject {
  planId     String
  subjectId  String
  level      Int // 0 iniciante … 3 domina
  diagnostic Json // respostas do formulário

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@id([planId, subjectId])
}

model Week {
  id            String   @id @default(cuid())
  planId        String
  index         Int // 1..N
  startDate     DateTime @db.Date
  targetMinutes Int
  kind          WeekKind @default(CONTENT)

  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([planId, index])
}

model Activity {
  id             String         @id @default(cuid())
  planId         String
  weekId         String
  sortOrder      Int
  type           ActivityType
  subjectId      String
  aulaId         String
  editalItemId   String?
  editalTopic    String?
  plannedMinutes Int            @default(60)
  status         ActivityStatus @default(PENDING)
  completedAt    DateTime?
  key            String // chave estável vinda do planejador ("aula#T1")
  scope          ActivityScope  @default(AULA)
  // Fixação: faixas de páginas da seção de questões comentadas [{start,end,sourceAula?}]
  fixRanges      Json?
  // Questões: quantidade e limite do caderno (mixed = sorteia de vários trechos da disciplina)
  quizQuestions  Int?           @default(25)
  quizLimitSec   Int?           @default(3600)
  quizMixed      Boolean        @default(false)
  // dia da semana planejado: 0 = segunda … 6 = domingo (nulo em planos antigos)
  dayIndex       Int?
  // Modo Turbo: Teoria substituída pelo resumo (Bizu) do trecho
  turbo          Boolean        @default(false)

  week        Week              @relation(fields: [weekId], references: [id], onDelete: Cascade)
  subject     Subject           @relation(fields: [subjectId], references: [id])
  aula        Aula              @relation(fields: [aulaId], references: [id])
  editalItem  EditalItem?       @relation(fields: [editalItemId], references: [id])
  segments    ActivitySegment[]
  refs        ActivityRef[]     @relation("ActivityRefFrom")
  refBy       ActivityRef[]     @relation("ActivityRefTo")
  timeLogs    TimeLog[]
  quizzes     QuizSession[]
  bizuAnswers BizuAnswer[]

  @@unique([planId, key])
  @@index([weekId, sortOrder])
  @@index([planId, type, status])
  @@index([editalItemId])
}

// Quais segmentos de teoria a atividade cobre (Teoria: 1; Revisão: até 3; Questões: 1+).
model ActivitySegment {
  activityId String
  segmentId  String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  segment  Segment  @relation(fields: [segmentId], references: [id])

  @@id([activityId, segmentId])
}

// Revisão/Questões sempre atreladas a Teoria(s) anterior(es).
model ActivityRef {
  activityId    String // a atividade que referencia (Revisão/Questões)
  refActivityId String // a Teoria referenciada

  activity    Activity @relation("ActivityRefFrom", fields: [activityId], references: [id], onDelete: Cascade)
  refActivity Activity @relation("ActivityRefTo", fields: [refActivityId], references: [id], onDelete: Cascade)

  @@id([activityId, refActivityId])
}

model TimeLog {
  id         String     @id @default(cuid())
  userId     String
  activityId String?
  seconds    Int
  startedAt  DateTime
  endedAt    DateTime?
  source     TimeSource
  note       String?
  createdAt  DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([activityId])
}

// "Meu resumo" do aluno por segmento (usado na Revisão).
model Note {
  userId    String
  segmentId String
  text      String
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment Segment @relation(fields: [segmentId], references: [id])

  @@id([userId, segmentId])
}

model QuizSession {
  id            String    @id @default(cuid())
  userId        String
  activityId    String?
  kind          QuizKind  @default(CADERNO)
  title         String?
  contest       Contest?
  limitSeconds  Int       @default(3600)
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  autoSubmitted Boolean   @default(false)
  score         Int? // acertos
  total         Int       @default(25)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  answers  QuizAnswer[]

  @@index([userId, startedAt])
  @@index([userId, kind])
}

model QuizAnswer {
  id           String    @id @default(cuid())
  sessionId    String
  questionId   String
  position     Int
  chosenLabel  String? // null = em branco
  isCorrect    Boolean?
  secondsSpent Int       @default(0)
  flagged      Boolean   @default(false)
  answeredAt   DateTime?

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([sessionId, position])
  @@index([questionId])
}

model BizuAnswer {
  id         String   @id @default(cuid())
  userId     String
  bizuItemId String
  activityId String?
  answer     Boolean
  isCorrect  Boolean
  answeredAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  item     BizuItem  @relation(fields: [bizuItemId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId, bizuItemId])
}

model QuestionReport {
  id         String       @id @default(cuid())
  userId     String
  questionId String
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, status])
}

// Lista de espera: o interessado informa nome, e-mail e usuário e paga por Pix (a mensagem do Pix leva o e-mail).
// O administrador confere o pagamento e libera o acesso com um convite.
model WaitlistEntry {
  id              String        @id @default(cuid())
  contest         Contest
  name            String
  email           String // minúsculas
  username        String        @unique // minúsculas
  plan            WaitlistPlan? // plano escolhido (define o valor do Pix); nulo nos cadastros anteriores aos planos
  status          String        @default("PENDING") // PENDING, APPROVED, REJECTED
  approvedAt      DateTime?
  rejectedAt      DateTime?
  accessDuration  String? // "30_DAYS" ou "INDEFINITE"
  rejectionReason String?
  createdAt       DateTime      @default(now())
  paidAt          DateTime? // preenchido pelo administrador ao conferir o Pix
  note            String?

  contracts Contract[]

  @@unique([contest, email])
  @@index([createdAt])
  @@index([status])
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
