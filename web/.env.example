# Copie para .env (desenvolvimento) e configure as mesmas chaves na Vercel (Settings > Environment Variables).
# Postgres. Em producao use a URL "pooled" do provedor (Neon/Supabase) com ?sslmode=require
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Pix da lista de espera (sem PIX_KEY a tela de pagamento nao funciona)
PIX_KEY=""
PIX_RECEIVER_NAME="MENTORIA"
PIX_CITY="RECIFE"

# Libera as telas do aluno (Missao, Meta, Plano, Desempenho). Em producao so de cadastro, deixe vazio ou "false".
# Administradores sempre entram.
APP_ENABLED="true"

# Somente dev: mostra questoes/bizus em DRAFT aos alunos
SERVE_DRAFT_QUESTIONS="true"

# Envio de E-mails (aprovação de cadastros e recuperação de senha)
# Opção A: Resend (Recomendado - https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="MentorIA CBMPE <contato@missaomentoria.com.br>"

# Opção B: SMTP (Gmail, Hostinger, Brevo, Zoho, etc.)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="seu-email@gmail.com"
# SMTP_PASS="sua-senha-de-app"
# SMTP_SECURE="false"
